{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "submission.json — stessi campi di submission.example.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "round_id", "answers"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "round_id": { "type": "string", "minLength": 1 },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "question", "answer", "contexts", "telemetry"],
        "properties": {
          "question_id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "contexts": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rank", "document_id", "content"],
              "properties": {
                "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
                "document_id": { "type": "string", "minLength": 1 },
                "content": { "type": "string", "minLength": 1 }
              }
            }
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["latency_ms", "declared_cost_eur", "model_calls"],
            "properties": {
              "latency_ms": { "type": "integer", "minimum": 0 },
              "declared_cost_eur": { "type": "number", "minimum": 0 },
              "model_calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "model",
                    "input_tokens",
                    "output_tokens",
                    "cached_input_tokens"
                  ],
                  "properties": {
                    "provider": { "type": "string", "minLength": 1 },
                    "model": { "type": "string", "minLength": 1 },
                    "input_tokens": { "type": "integer", "minimum": 0 },
                    "output_tokens": { "type": "integer", "minimum": 0 },
                    "cached_input_tokens": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
